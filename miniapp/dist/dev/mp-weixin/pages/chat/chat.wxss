.chat-page.data-v-a041b13f {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #FDF8F3;
}

/* 消息列表 */
.msg-list.data-v-a041b13f {
  flex: 1;
  padding: 12px 16px 8px;
  overflow-y: auto;
}

/* 欢迎区域 */
.welcome.data-v-a041b13f {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30px 16px;
}
.welcome-icon-wrap.data-v-a041b13f {
  width: 80px;
  height: 80px;
  border-radius: 24px;
  background: linear-gradient(135deg, #E8F5E9, #C8E6C9);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16px;
}
.welcome-icon.data-v-a041b13f {
  font-size: 40px;
}
.welcome-title.data-v-a041b13f {
  font-size: 20px;
  font-weight: 700;
  color: #1A4A2E;
  text-align: center;
  margin-bottom: 8px;
}
.welcome-desc.data-v-a041b13f {
  font-size: 13px;
  color: #8B7355;
  text-align: center;
  line-height: 1.5;
  margin-bottom: 20px;
}
.welcome-suggestions.data-v-a041b13f {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.suggestion-item.data-v-a041b13f {
  padding: 12px 16px;
  background: #fff;
  border-radius: 12px;
  border: 1px solid #E8E0D4;
}
.suggestion-item.data-v-a041b13f:active {
  background: #E8F5E9;
  border-color: #2D7A4A;
}
.suggestion-text.data-v-a041b13f {
  font-size: 14px;
  color: #5C4033;
}

/* 消息行 */
.msg-row.data-v-a041b13f {
  display: flex;
  gap: 8px;
  margin-bottom: 16px;
  align-items: flex-start;
}
.msg-row-user.data-v-a041b13f {
  flex-direction: row-reverse;
}
.msg-row-ai.data-v-a041b13f {
  flex-direction: row;
}
.msg-avatar.data-v-a041b13f {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5EDE0;
  flex-shrink: 0;
}
.msg-avatar-user.data-v-a041b13f {
  background: linear-gradient(135deg, #2D7A4A, #1A4A2E);
}
.avatar-icon.data-v-a041b13f {
  font-size: 18px;
}
.msg-content.data-v-a041b13f {
  max-width: 78%;
  display: flex;
  flex-direction: column;
}

/* 气泡 */
.bubble.data-v-a041b13f {
  padding: 12px 14px;
  border-radius: 16px;
  font-size: 14px;
  line-height: 1.6;
}
.bubble-user.data-v-a041b13f {
  background: linear-gradient(135deg, #2D7A4A, #1A4A2E);
  color: #fff;
  border-radius: 16px 16px 4px 16px;
}
.bubble-ai.data-v-a041b13f {
  background: #fff;
  color: #2C1810;
  border-radius: 4px 16px 16px 16px;
  border: 1px solid #F0ECE4;
  border-left: 4px solid #2D7A4A;
  box-shadow: 0 1px 4px rgba(0,0,0,0.03);
}
.bubble-text.data-v-a041b13f {
  word-break: break-word;
}
.msg-time.data-v-a041b13f {
  font-size: 10px;
  color: #C4A882;
  margin-top: 4px;
  padding: 0 4px;
}

/* loading 动画 */
.loading-dots.data-v-a041b13f {
  display: flex;
  gap: 4px;
  padding: 4px 0;
}
.dot.data-v-a041b13f {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #2D7A4A;
  animation: dotBounce-a041b13f 1.4s infinite ease-in-out;
}
.dot-1.data-v-a041b13f { animation-delay: 0s;
}
.dot-2.data-v-a041b13f { animation-delay: 0.2s;
}
.dot-3.data-v-a041b13f { animation-delay: 0.4s;
}
@keyframes dotBounce-a041b13f {
0%, 80%, 100% { transform: scale(0.6); opacity: 0.4;
}
40% { transform: scale(1); opacity: 1;
}
}
.error-text.data-v-a041b13f {
  color: #DC2626;
  font-size: 13px;
}

/* 气泡操作按钮 */
.bubble-actions.data-v-a041b13f {
  display: flex;
  gap: 12px;
  margin-top: 8px;
  padding-top: 6px;
  border-top: 1px solid #F0ECE4;
}
.action-btn.data-v-a041b13f {
  font-size: 12px;
  color: #8B7355;
  padding: 2px 4px;
}

/* 图片预览 */
.preview-bar.data-v-a041b13f {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 16px;
  background: #F8F6F2;
  border-top: 1px solid #E8E0D4;
}
.preview-img.data-v-a041b13f {
  width: 48px;
  height: 48px;
  border-radius: 8px;
  flex-shrink: 0;
}
.preview-label.data-v-a041b13f {
  flex: 1;
  font-size: 12px;
  color: #5C4033;
}
.preview-close.data-v-a041b13f {
  font-size: 18px;
  color: #C4A882;
  padding: 4px;
}

/* 输入区 */
.input-area.data-v-a041b13f {
  padding: 8px 12px 12px;
  background: #fff;
  border-top: 1px solid #E8E0D4;
}
.input-box.data-v-a041b13f {
  display: flex;
  align-items: center;
  background: #F8F6F2;
  border-radius: 14px;
  padding: 6px 8px;
  gap: 4px;
  border: 2px solid transparent;
  transition: border-color 0.2s;
}
.input-box.data-v-a041b13f:focus-within {
  border-color: #2D7A4A;
}
.toolbar.data-v-a041b13f {
  display: flex;
  gap: 2px;
}
.tool-btn.data-v-a041b13f {
  font-size: 20px;
  padding: 6px;
}
.tool-btn.recording.data-v-a041b13f {
  color: #DC2626;
  animation: pulse-a041b13f 1s infinite;
}
@keyframes pulse-a041b13f {
0%, 100% { transform: scale(1);
}
50% { transform: scale(1.2);
}
}
.text-input.data-v-a041b13f {
  flex: 1;
  font-size: 15px;
  height: 36px;
  color: #2C1810;
  padding: 0 8px;
}
.text-input.data-v-a041b13f::-moz-placeholder {
  color: #C4A882;
}
.text-input.data-v-a041b13f::placeholder {
  color: #C4A882;
}
.send-btn.data-v-a041b13f {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: linear-gradient(135deg, #2D7A4A, #1A4A2E);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  box-shadow: 0 2px 8px rgba(45,122,74,0.3);
}
.send-btn.disabled.data-v-a041b13f {
  opacity: 0.4;
  box-shadow: none;
}
.send-btn-stop.data-v-a041b13f {
  background: #DC2626;
  font-size: 14px;
}

/* 会话列表弹窗 */
.session-mask.data-v-a041b13f {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.3);
  z-index: 200;
}
.session-panel.data-v-a041b13f {
  position: fixed;
  top: 0; left: 0; bottom: 0;
  width: 280px;
  background: #fff;
  z-index: 201;
  transform: translateX(-100%);
  transition: transform 0.3s ease;
  box-shadow: 2px 0 20px rgba(0,0,0,0.1);
}
.session-panel.show.data-v-a041b13f {
  transform: translateX(0);
}
.panel-header.data-v-a041b13f {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 60px 16px 12px;
  border-bottom: 1px solid #E8E0D4;
}
.panel-title.data-v-a041b13f {
  font-size: 16px;
  font-weight: 700;
  color: #1A4A2E;
}
.panel-close.data-v-a041b13f {
  font-size: 18px;
  color: #8B7355;
  padding: 4px;
}
.panel-list.data-v-a041b13f {
  height: calc(100vh - 100px);
  padding: 8px;
}
.session-item.data-v-a041b13f {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px;
  border-radius: 10px;
  margin-bottom: 4px;
  transition: background 0.2s;
}
.session-item.active.data-v-a041b13f {
  background: #E8F5E9;
}
.session-item.data-v-a041b13f:active {
  background: #F5EDE0;
}
.session-info.data-v-a041b13f {
  flex: 1;
  min-width: 0;
}
.session-title.data-v-a041b13f {
  font-size: 13px;
  font-weight: 500;
  color: #2C1810;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.session-time.data-v-a041b13f {
  font-size: 11px;
  color: #C4A882;
  margin-top: 2px;
}
.session-del.data-v-a041b13f {
  font-size: 14px;
  padding: 4px;
}
.nav-actions.data-v-a041b13f {
  display: flex;
  gap: 4px;
}
.nav-btn.data-v-a041b13f {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}
.nav-btn.data-v-a041b13f:active {
  background: rgba(0,0,0,0.04);
}
.nav-btn-icon.data-v-a041b13f {
  font-size: 18px;
}