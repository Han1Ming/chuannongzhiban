.farm-match-page.data-v-be780924 {
  min-height: 100vh;
  background: #FDF8F3;
}
.match-scroll.data-v-be780924 {
  padding: 0 16px;
  height: calc(100vh - 44px);
}

/* 选择器卡片 */
.picker-card.data-v-be780924 {
  background: #fff;
  border-radius: 16px;
  padding: 8px 20px;
  margin: 16px 0;
  box-shadow: 0 2px 12px rgba(26, 74, 46, 0.04);
}
.picker-row.data-v-be780924 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 0;
  border-bottom: 1px solid #F5EDE0;
}
.picker-row.data-v-be780924:last-child {
  border-bottom: none;
}
.picker-label.data-v-be780924 {
  font-size: 15px;
  color: #2C1810;
  font-weight: 500;
}
.picker-value.data-v-be780924 {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 15px;
  color: #2D7A4A;
  font-weight: 500;
}
.picker-value .placeholder.data-v-be780924 {
  color: #C4A882;
}
.picker-arrow.data-v-be780924 {
  font-size: 18px;
  color: #C4A882;
}
.match-btn.data-v-be780924 {
  width: 100%;
  padding: 16px;
  background: linear-gradient(135deg, #2D7A4A, #1A4A2E);
  border-radius: 14px;
  color: #fff;
  font-size: 16px;
  font-weight: 600;
  border: none;
  box-shadow: 0 4px 16px rgba(45, 122, 74, 0.3);
  margin-bottom: 20px;
}
.match-btn[disabled].data-v-be780924 {
  opacity: 0.5;
  box-shadow: none;
}

/* 匹配中 */
.matching.data-v-be780924 {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40px 0;
}
.matching-dots.data-v-be780924 {
  display: flex;
  gap: 6px;
  margin-bottom: 16px;
}
.matching-dots .dot.data-v-be780924 {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #2D7A4A;
  animation: dotPulse-be780924 1.4s infinite;
}
.matching-dots .dot-1.data-v-be780924 { animation-delay: 0s;
}
.matching-dots .dot-2.data-v-be780924 { animation-delay: 0.2s;
}
.matching-dots .dot-3.data-v-be780924 { animation-delay: 0.4s;
}
@keyframes dotPulse-be780924 {
0%, 80%, 100% { transform: scale(0.6); opacity: 0.4;
}
40% { transform: scale(1); opacity: 1;
}
}
.matching-text.data-v-be780924 {
  font-size: 14px;
  color: #8B7355;
}

/* 结果 */
.result-card.data-v-be780924 {
  background: #fff;
  border-radius: 16px;
  padding: 20px;
  box-shadow: 0 2px 12px rgba(26, 74, 46, 0.06);
  margin-bottom: 20px;
}
.result-header.data-v-be780924 {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 16px;
  padding-bottom: 12px;
  border-bottom: 1px solid #E8F5E9;
}
.result-icon.data-v-be780924 {
  font-size: 24px;
}
.result-title.data-v-be780924 {
  font-size: 16px;
  font-weight: 700;
  color: #1A4A2E;
}
.result-crop.data-v-be780924 {
  text-align: center;
  padding: 16px 0;
  background: #F0F9F1;
  border-radius: 12px;
  margin-bottom: 16px;
}
.crop-label.data-v-be780924 {
  font-size: 13px;
  color: #8B7355;
  display: block;
  margin-bottom: 6px;
}
.crop-name.data-v-be780924 {
  font-size: 22px;
  font-weight: 700;
  color: #2D7A4A;
}
.result-plan.data-v-be780924 {
  background: #F8F6F2;
  border-radius: 12px;
  padding: 14px;
}
.plan-text.data-v-be780924 {
  font-size: 14px;
  color: #5C4033;
  line-height: 1.7;
}
.bottom-safe.data-v-be780924 {
  height: 30px;
}