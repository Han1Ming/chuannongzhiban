.diagnose-page.data-v-3014a9b4 {
  min-height: 100vh;
  background: #FDF8F3;
}
.diagnose-scroll.data-v-3014a9b4 {
  padding: 0 16px;
  height: calc(100vh - 44px);
}

/* 上传区域 */
.upload-area.data-v-3014a9b4 {
  margin: 16px 0;
}
.upload-box.data-v-3014a9b4 {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40px 20px;
  background: #fff;
  border-radius: 16px;
  border: 2px dashed #E8E0D4;
  transition: border-color 0.2s;
}
.upload-box.data-v-3014a9b4:active {
  border-color: #2D7A4A;
  background: #F8F6F2;
}
.upload-icon.data-v-3014a9b4 {
  font-size: 48px;
  margin-bottom: 12px;
}
.upload-title.data-v-3014a9b4 {
  font-size: 16px;
  font-weight: 600;
  color: #2C1810;
  margin-bottom: 6px;
}
.upload-desc.data-v-3014a9b4 {
  font-size: 13px;
  color: #8B7355;
  margin-bottom: 4px;
}
.upload-hint.data-v-3014a9b4 {
  font-size: 12px;
  color: #C4A882;
}

/* 预览 */
.preview-list.data-v-3014a9b4 {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;
}
.preview-item.data-v-3014a9b4 {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
  border-radius: 12px;
  overflow: hidden;
  background: #f0ece4;
}
.preview-img.data-v-3014a9b4 {
  width: 100%;
  height: 100%;
}
.preview-del.data-v-3014a9b4 {
  position: absolute;
  top: 4px;
  right: 4px;
  width: 20px;
  height: 20px;
  background: rgba(0,0,0,0.5);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
}
.preview-add.data-v-3014a9b4 {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2px dashed #E8E0D4;
  background: #F8F6F2;
}
.add-icon.data-v-3014a9b4 {
  font-size: 28px;
  color: #C4A882;
}
.upload-count.data-v-3014a9b4 {
  display: block;
  text-align: center;
  font-size: 12px;
  color: #8B7355;
  margin-top: 8px;
}

/* 诊断按钮 */
.diagnose-btn.data-v-3014a9b4 {
  width: 100%;
  padding: 16px;
  background: linear-gradient(135deg, #2D7A4A, #1A4A2E);
  border-radius: 14px;
  color: #fff;
  font-size: 16px;
  font-weight: 600;
  border: none;
  box-shadow: 0 4px 16px rgba(45, 122, 74, 0.3);
  margin-bottom: 20px;
}
.diagnose-btn[disabled].data-v-3014a9b4 {
  opacity: 0.5;
  box-shadow: none;
}

/* 结果 */
.results.data-v-3014a9b4 {
  margin-bottom: 20px;
}
.result-header.data-v-3014a9b4 {
  margin-bottom: 12px;
}
.result-title.data-v-3014a9b4 {
  font-size: 16px;
  font-weight: 700;
  color: #1A4A2E;
}
.result-summary.data-v-3014a9b4 {
  background: #F0F9F1;
  border-radius: 12px;
  padding: 14px;
  margin-bottom: 12px;
}
.summary-text.data-v-3014a9b4 {
  font-size: 13px;
  color: #1A4A2E;
  line-height: 1.6;
}
.bottom-safe.data-v-3014a9b4 {
  height: 30px;
}