.login-page.data-v-cdfe2409 {
  min-height: 100vh;
  background: #FDF8F3;
}
.login-header.data-v-cdfe2409 {
  position: relative;
  padding: 60px 20px 40px;
  text-align: center;
  overflow: hidden;
}
.header-bg.data-v-cdfe2409 {
  position: absolute;
  top: -60px;
  left: 50%;
  transform: translateX(-50%);
  width: 500px;
  height: 500px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(232, 245, 233, 0.8) 0%, rgba(232, 245, 233, 0.2) 50%, transparent 70%);
  pointer-events: none;
}
.logo-area.data-v-cdfe2409 {
  position: relative;
  z-index: 1;
}
.logo-icon.data-v-cdfe2409 {
  font-size: 64px;
  margin-bottom: 12px;
}
.app-name.data-v-cdfe2409 {
  display: block;
  font-size: 28px;
  font-weight: 700;
  color: #1A4A2E;
  margin-bottom: 6px;
}
.app-desc.data-v-cdfe2409 {
  font-size: 14px;
  color: #8B7355;
}

/* Tab切换 */
.tab-bar.data-v-cdfe2409 {
  display: flex;
  margin: 0 20px;
  background: #F5EDE0;
  border-radius: 12px;
  padding: 3px;
}
.tab-item.data-v-cdfe2409 {
  flex: 1;
  text-align: center;
  padding: 10px 0;
  border-radius: 10px;
  font-size: 14px;
  font-weight: 500;
  color: #8B7355;
  transition: all 0.3s;
}
.tab-item.active.data-v-cdfe2409 {
  background: #fff;
  color: #2D7A4A;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}
.tab-content.data-v-cdfe2409 {
  padding: 30px 20px;
}

/* 微信登录 */
.wechat-btn.data-v-cdfe2409 {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  padding: 16px;
  background: linear-gradient(135deg, #2D7A4A, #1A4A2E);
  border-radius: 14px;
  color: #fff;
  font-size: 16px;
  font-weight: 600;
  border: none;
  box-shadow: 0 4px 16px rgba(45, 122, 74, 0.3);
  margin-bottom: 20px;
}
.wechat-btn.data-v-cdfe2409:active {
  transform: scale(0.97);
  opacity: 0.9;
}
.wechat-icon.data-v-cdfe2409 { font-size: 22px;
}
.agreement.data-v-cdfe2409 {
  display: block;
  text-align: center;
  font-size: 12px;
  color: #C4A882;
  line-height: 1.6;
}
.link.data-v-cdfe2409 {
  color: #2D7A4A;
  text-decoration: underline;
}

/* 密码登录 */
.input-group.data-v-cdfe2409 {
  margin-bottom: 24px;
}
.input-item.data-v-cdfe2409 {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12px;
  padding: 14px 16px;
  margin-bottom: 12px;
  border: 1px solid #E8E0D4;
  box-shadow: 0 1px 4px rgba(0,0,0,0.02);
}
.input-label.data-v-cdfe2409 {
  font-size: 18px;
  margin-right: 10px;
}
.input-field.data-v-cdfe2409 {
  flex: 1;
  font-size: 15px;
  color: #2C1810;
  height: 22px;
}
.input-field.data-v-cdfe2409::-moz-placeholder {
  color: #C4A882;
}
.input-field.data-v-cdfe2409::placeholder {
  color: #C4A882;
}
.login-btn.data-v-cdfe2409 {
  width: 100%;
  padding: 16px;
  background: linear-gradient(135deg, #2D7A4A, #1A4A2E);
  border-radius: 14px;
  color: #fff;
  font-size: 16px;
  font-weight: 600;
  border: none;
  box-shadow: 0 4px 16px rgba(45, 122, 74, 0.3);
}
.login-btn[disabled].data-v-cdfe2409 {
  opacity: 0.5;
  box-shadow: none;
}
.login-links.data-v-cdfe2409 {
  text-align: center;
  margin-top: 20px;
}