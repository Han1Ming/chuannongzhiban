.profile-page.data-v-04d37cba {
  min-height: 100vh;
  background: #FDF8F3;
}
.profile-scroll.data-v-04d37cba {
  padding: 0 16px;
  height: calc(100vh - 50px);
}

/* 用户卡片 */
.user-card.data-v-04d37cba {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 20px;
  background: linear-gradient(135deg, #E8F5E9, #C8E6C9);
  border-radius: 16px;
  margin: 12px 0 20px;
  box-shadow: 0 4px 16px rgba(26, 74, 46, 0.08);
}
.user-avatar.data-v-04d37cba {
  width: 56px;
  height: 56px;
  border-radius: 16px;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}
.placeholder-avatar.data-v-04d37cba {
  background: #F5EDE0;
}
.avatar-text.data-v-04d37cba {
  font-size: 24px;
  color: #1A4A2E;
}
.user-info.data-v-04d37cba {
  flex: 1;
}
.user-name.data-v-04d37cba {
  display: block;
  font-size: 17px;
  font-weight: 700;
  color: #1A4A2E;
}
.user-phone.data-v-04d37cba {
  display: block;
  font-size: 13px;
  color: #5C4033;
  margin-top: 2px;
}
.user-arrow.data-v-04d37cba {
  font-size: 24px;
  color: #2D7A4A;
}
.user-badge.data-v-04d37cba {
  padding: 4px 12px;
  background: rgba(255,255,255,0.6);
  border-radius: 20px;
  font-size: 12px;
  color: #1A4A2E;
}

/* 菜单 */
.menu-section.data-v-04d37cba {
  background: #fff;
  border-radius: 14px;
  margin-bottom: 12px;
  overflow: hidden;
  box-shadow: 0 1px 4px rgba(0,0,0,0.02);
}
.menu-item.data-v-04d37cba {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 16px;
  border-bottom: 1px solid #F5EDE0;
}
.menu-item.data-v-04d37cba:last-child {
  border-bottom: none;
}
.menu-item.data-v-04d37cba:active {
  background: #F8F6F2;
}
.menu-icon.data-v-04d37cba {
  font-size: 20px;
  width: 28px;
  text-align: center;
}
.menu-label.data-v-04d37cba {
  flex: 1;
  font-size: 14px;
  color: #2C1810;
}
.menu-arrow.data-v-04d37cba {
  font-size: 18px;
  color: #C4A882;
}

/* 退出 */
.logout-section.data-v-04d37cba {
  margin-top: 30px;
  padding-bottom: 40px;
}
.logout-btn.data-v-04d37cba {
  width: 100%;
  padding: 14px;
  background: transparent;
  border: 1px solid #DC2626;
  border-radius: 12px;
  color: #DC2626;
  font-size: 15px;
  font-weight: 500;
  text-align: center;
}
.logout-btn.data-v-04d37cba:active {
  background: #FEF2F2;
}

/* 关于弹窗 */
.about-mask.data-v-04d37cba {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 200;
}
.about-panel.data-v-04d37cba {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 20px 20px 0 0;
  padding: 30px 24px;
  z-index: 201;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}
.about-panel.show.data-v-04d37cba {
  transform: translateY(0);
}
.about-title.data-v-04d37cba {
  display: block;
  font-size: 22px;
  font-weight: 700;
  color: #1A4A2E;
  text-align: center;
  margin-bottom: 6px;
}
.about-version.data-v-04d37cba {
  display: block;
  text-align: center;
  font-size: 13px;
  color: #C4A882;
  margin-bottom: 20px;
}
.about-desc.data-v-04d37cba {
  display: block;
  font-size: 14px;
  color: #5C4033;
  line-height: 1.7;
  text-align: center;
  margin-bottom: 24px;
}
.about-close.data-v-04d37cba {
  width: 100%;
  padding: 14px;
  background: #E8F5E9;
  border: none;
  border-radius: 12px;
  color: #2D7A4A;
  font-size: 15px;
  font-weight: 600;
  text-align: center;
}